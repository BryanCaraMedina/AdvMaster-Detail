<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AdvMasterDetail" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Primary brand color (Toolbar) -->
        <item name="colorPrimary">#1A237E</item>
        <item name="colorPrimaryVariant">#000051</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">#303F9F</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">#000051</item>

        <!-- App background -->
        <item name="android:windowBackground">@drawable/app_background</item>
    </style>

    <style name="Theme.AdvMasterDetail" parent="Base.Theme.AdvMasterDetail" />
</resources>